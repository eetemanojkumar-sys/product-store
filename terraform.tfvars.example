aws_region        = "ap-south-1"
environment       = "dev"
project_name      = "product-store"
vpc_cidr          = "10.20.0.0/16"

# Replace with your current public IPv4 address in /32 CIDR format.
admin_cidr        = "203.0.113.10/32"
app_ingress_cidr  = "203.0.113.10/32"

# Must already exist as an EC2 key pair in ap-south-1.
key_name          = "replace-with-existing-keypair-name"

instance_type     = "t3.micro"
db_instance_class = "db.t3.micro"
db_name           = "productstore"
db_username       = "productadmin"
db_allocated_storage = 20

# Do not put db_password here. Set TF_VAR_db_password in your shell instead.
